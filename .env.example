# ==============================================================================
# CTF Challenge Toolkit - Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env in your workspace, current directory, or repository root.
# Shell environment variables always take precedence over values defined in .env.

# --- Solver & AI Engine Settings ---
# Global cap for parallel solver workers per workspace (CLI --workers cannot exceed this cap)
CTF_SOLVER_MAX_WORKERS=3

# Default solver engine: agy | gpt | claude | codex | generic
CTF_SOLVER_ENGINE=agy

# Path to Antigravity CLI binary (overrides automatic PATH search)
# AGY_BIN=/usr/local/bin/agy

# --- UI & Display Settings ---
# Terminal color palette: exodia | matrix | cyberpunk | dracula | nord | monokai | phosphor | amber
CTF_THEME=exodia

# Enable detailed verbose logging and stack traces (0 or 1)
CTF_DEBUG=0

# --- Network & Proxy Settings ---
# Allow self-signed or invalid SSL/TLS certificates (0 or 1)
CTF_INSECURE=0

# HTTP and HTTPS proxy endpoints (e.g. for Burp Suite or corporate proxy)
# HTTP_PROXY=http://127.0.0.1:8080
# HTTPS_PROXY=http://127.0.0.1:8080

# --- Directory & Storage Settings ---
# Default root directory for all downloaded CTF workspaces (default: ~/Workspace/CTF)
# CTF_WORKSPACE_ROOT=/home/light/Workspace/CTF

# --- Port Overrides ---
# Browser extension bridge daemon port (default: 18888)
# CTF_BRIDGE_PORT=18888

# Web dashboard server port (default: 8689)
# CTF_DASHBOARD_PORT=8689

# Burp Suite MCP bridge port (default: 9876)
# BURP_MCP_PORT=9876

# --- Resilience & Recovery Settings ---
# Enable automatic BQA retry on failed operations (0 or 1)
CTF_BQA_RETRY=0

# Completely disable BQA recovery hooks (0 or 1)
CTF_DISABLE_BQA=0
